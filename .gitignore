# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code agent rules (kept local, not committed)
/CLAUDE.md
/.claude/
# browser-check screenshots from test runs (may show test-account data)
/docs/superpowers/plans/ui-baseline/
# raw schema export from Supabase (user counts, metadata keys)
/docs/superpowers/audit/schema.json
